<Window x:Class="ChatClient.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Login" Height="150" Width="300"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <StackPanel Margin="15">
            <TextBlock Text="Enter Admin Password:"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,10"/>
            <Button Content="Login" Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
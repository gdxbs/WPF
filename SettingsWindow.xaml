<Window x:Class="ChatClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="600" Width="500"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Name="SettingsTabControl">
            <TabItem Header="Appearance" Background="{DynamicResource PanelBrush}"
                      Foreground="{DynamicResource ForegroundBrush}">
                <Grid Background="{DynamicResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Theme" Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,10" FontWeight="Bold"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton Name="LightThemeRadio" Content="Light" Margin="0,0,15,0"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton Name="DarkThemeRadio" Content="Dark"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     Checked="ThemeRadio_Checked"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Accent Color" Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,10" FontWeight="Bold"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Blue" Width="80" Click="AccentColor_Blue"
                                Background="#0078D4" Foreground="White" Cursor="Hand" Margin="0,0,5,0"/>
                        <Button Content="Green" Width="80" Click="AccentColor_Green"
                                Background="#10B981" Foreground="White" Cursor="Hand" Margin="0,0,5,0"/>
                        <Button Content="Orange" Width="80" Click="AccentColor_Orange"
                                Background="#F59E0B" Foreground="White" Cursor="Hand" Margin="0,0,5,0"/>
                        <Button Content="Red" Width="80" Click="AccentColor_Red"
                                Background="#EF4444" Foreground="White" Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="Font Size" Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,5" FontWeight="Bold"/>
                    <StackPanel Grid.Row="5" Margin="0,0,0,15">
                        <Slider Name="FontSizeSlider" Minimum="10" Maximum="18" Value="12"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Background="{DynamicResource AccentBrush}"/>
                        <TextBlock Name="FontSizeValue" Text="12pt"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Notifications" Background="{DynamicResource PanelBrush}"
                      Foreground="{DynamicResource ForegroundBrush}">
                <Grid Background="{DynamicResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Name="SoundEnabledCheckBox" Content="Enable Sound Notifications"
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15" IsChecked="True"/>

                    <TextBlock Grid.Row="1" Text="Notification Volume" Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,5" FontWeight="Bold"/>
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <Slider Name="VolumeSlider" Minimum="0" Maximum="100" Value="70"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Background="{DynamicResource AccentBrush}"/>
                        <TextBlock Name="VolumeValue" Text="70%"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <CheckBox Grid.Row="3" Name="MessageNotifyCheckBox" Content="Message Notifications"
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10" IsChecked="True"/>

                    <CheckBox Grid.Row="4" Name="JoinLeaveNotifyCheckBox" Content="Join/Leave Notifications"
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10" IsChecked="True"/>

                    <CheckBox Grid.Row="5" Name="ErrorNotifyCheckBox" Content="Error Notifications"
                              Foreground="{DynamicResource ForegroundBrush}" IsChecked="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="Connection" Background="{DynamicResource PanelBrush}"
                      Foreground="{DynamicResource ForegroundBrush}">
                <Grid Background="{DynamicResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Name="AutoConnectCheckBox" Content="Auto-connect on startup"
                              Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,15"/>

                    <TextBlock Grid.Row="1" Text="Last Connection Details" Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,10" FontWeight="Bold"/>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Host:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                        <TextBox Name="SavedHostTextBox" Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Port:" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,3"/>
                        <TextBox Name="SavedPortTextBox" Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Advanced" Background="{DynamicResource PanelBrush}"
                      Foreground="{DynamicResource ForegroundBrush}">
                <Grid Background="{DynamicResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Background Image" Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,10" FontWeight="Bold"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox Name="BackgroundImagePathTextBox" Width="300" VerticalAlignment="Center"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,10,0"/>
                        <Button Content="Browse..." Click="BrowseBackgroundImage_Click"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White" Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Window Transparency" Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,5" FontWeight="Bold"/>
                    <Slider Grid.Row="3" Name="TransparencySlider" Minimum="20" Maximum="100" Value="100"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Width="80" Click="SaveButton_Click" Margin="0,0,10,0"
                    Background="{DynamicResource SuccessBrush}"
                    Foreground="White" Cursor="Hand"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click"
                    Background="{DynamicResource ErrorBrush}"
                    Foreground="White" Cursor="Hand" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

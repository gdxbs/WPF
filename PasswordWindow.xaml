<Window x:Class="ChatClient.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Password" Height="150" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter admin password:" Margin="10"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Margin="10"/>
        <Button Grid.Row="2" Content="OK" Margin="10" Click="OKButton_Click"/>
    </Grid>
</Window>

<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Client" Height="700" Width="1000"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Status:"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Name="StatusIndicator" Text="Disconnected"
                           Foreground="{DynamicResource ErrorBrush}" Margin="0,0,20,0" FontWeight="Bold"/>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Host:"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,5,0"/>

                <TextBox Grid.Column="2" Width="120" Margin="40,0,10,0"
                         Name="HostTextBox" Text="localhost"
                         Background="{DynamicResource BackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Port:"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,5,0"/>

                <TextBox Grid.Column="3" Width="80" Margin="35,0,10,0"
                         Name="PortTextBox" Text="9999"
                         Background="{DynamicResource BackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"/>

                <Button Grid.Column="4" HorizontalAlignment="Left" Width="80" Margin="10,0,10,0"
                        Name="ConnectButton" Content="Connect" Click="ConnectButton_Click"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White" Cursor="Hand"/>

                <Button Grid.Column="4" HorizontalAlignment="Left" Width="80" Margin="95,0,10,0"
                        Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click"
                        Background="{DynamicResource ErrorBrush}"
                        Foreground="White" Cursor="Hand" IsEnabled="False"/>

                <Button Grid.Column="5" Content="⚙" Width="35" Height="35" Padding="0"
                        Click="SettingsButton_Click"
                        Background="{DynamicResource PanelBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand" ToolTip="Settings"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Background="{DynamicResource PanelBrush}" Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Room Management" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Create Room" FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5"/>
                        <TextBox Name="CreateRoomIdTextBox" Placeholder="Room ID" Margin="0,0,0,5"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBox Name="CreateRoomNameTextBox" Placeholder="Room Name" Margin="0,0,0,5"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <Button Content="Create" Click="CreateRoomButton_Click"
                                Background="{DynamicResource SuccessBrush}"
                                Foreground="White" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Join Room" FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5"/>
                        <TextBox Name="JoinRoomIdTextBox" Placeholder="Room ID" Margin="0,0,0,5"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBox Name="JoinUsernameTextBox" Placeholder="Username" Margin="0,0,0,5"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <Button Content="Join" Click="JoinRoomButton_Click"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White" Cursor="Hand"/>
                    </StackPanel>

                    <Button Grid.Row="3" Content="List Rooms" Margin="0,0,0,10" Click="ListRoomsButton_Click"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White" Cursor="Hand"/>

                    <Button Grid.Row="4" Content="Leave Room" Click="LeaveRoomButton_Click"
                            Background="{DynamicResource WarningBrush}"
                            Foreground="White" Cursor="Hand" IsEnabled="False"
                            Name="LeaveRoomButton"/>

                    <ListBox Grid.Row="5" Name="RoomListBox" Margin="0,10,0,0"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"/>
                </Grid>
            </Border>

            <TabControl Grid.Column="1" Name="ChatTabControl"
                        Background="{DynamicResource BackgroundBrush}"
                        Foreground="{DynamicResource ForegroundBrush}">
            </TabControl>

            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Background="{DynamicResource PanelBrush}" Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Room Users" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" Name="UsersListBox"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

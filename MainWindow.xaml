<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Client" Height="700" Width="1000"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Closing="Window_Closing">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Status:"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Name="StatusIndicator" Text="Disconnected"
                           Foreground="{DynamicResource ErrorBrush}" Margin="0,0,20,0" FontWeight="Bold"/>

                <Button Grid.Column="2" Content="Logout" Click="LogoutButton_Click"
                        Background="{DynamicResource ErrorBrush}"
                        Foreground="White" Cursor="Hand" Margin="0,0,10,0"/>

                <Button Grid.Column="3" Content="⚙" Width="35" Height="35" Padding="0"
                        Click="SettingsButton_Click"
                        Background="{DynamicResource PanelBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand" ToolTip="Settings"/>
                <Button Grid.Column="4" Content="Admin" Width="60" Height="35" Padding="0"
                        Click="AdminButton_Click"
                        Background="{DynamicResource PanelBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Cursor="Hand" ToolTip="Admin Console" Margin="5,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Background="{DynamicResource PanelBrush}" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Room Management" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Create Room" FontSize="11"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,5"/>
                        <TextBox Name="CreateRoomIdTextBox" Margin="0,0,0,5"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <TextBox Name="CreateRoomNameTextBox" Margin="0,0,0,5"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        <Button Content="Create" Click="CreateRoomButton_Click"
                                Background="{DynamicResource SuccessBrush}"
                                Foreground="White" Cursor="Hand"/>
                        <TextBlock Name="CreateRoomStatusTextBlock" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,10,0,0" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Join Room" FontSize="11"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,5,5"/>
                            <Button Content="🔄" Click="RefreshRoomsButton_Click"
                                    Background="Transparent" BorderBrush="Transparent"
                                    Foreground="{DynamicResource ForegroundBrush}" Cursor="Hand"/>
                        </StackPanel>
                        <ListBox Name="RoomListBox" Margin="0,0,0,5" Height="200"
                                 SelectionMode="Extended"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <Button Content="Join" Click="JoinRoomButton_Click"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White" Cursor="Hand"/>
                        <TextBlock Name="JoinRoomStatusTextBlock" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

            <TabControl Grid.Column="1" Name="ChatTabControl"
                        Background="{DynamicResource BackgroundBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        SelectionChanged="ChatTabControl_SelectionChanged">
            </TabControl>

            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Background="{DynamicResource PanelBrush}" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Room Users" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" Name="UsersListBox"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
